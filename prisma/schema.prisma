generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Member {
  id        String   @id
  name      String
  createdAt DateTime @default(now())

  chats Chat[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("operator")
  createdAt DateTime @default(now())

  chats  Chat[]
  scores Score[]
}

model Chat {
  id    Int      @id @default(autoincrement())
  type  ChatType
  title String?

  /// 엔진 세션 파일은 엔진 쪽 디스크에 있어 이 값만으로 재개가 보장되지 않는다.
  sessionId String?

  memberId String
  member   Member @relation(fields: [memberId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  turns Turn[]

  @@index([createdAt])
  @@index([type])
  @@index([memberId])
}

model Turn {
  id     Int        @id @default(autoincrement())
  seq    Int
  status TurnStatus @default(QUEUED)

  question String
  answer   String?

  rawResult String?
  references String?
  trace String?

  pendingQuestions String?
  answeredInput String?

  elapsedMs Int?
  tokens    Int?
  filesRead Int?
  dbQueries Int?
  error     String?

  chatId Int
  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  score Score?

  @@unique([chatId, seq])
  @@index([status])
}

model Score {
  id Int @id @default(autoincrement())

  pathAccuracy    Int
  scopeMatch      Int
  convention      Int
  contentAccuracy Int
  askBackSafety   Int
  average Float
  note    String?

  turnId Int  @unique
  turn   Turn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  scoredById String
  scoredBy   User   @relation(fields: [scoredById], references: [id])

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model WikiDoc {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  body      String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category])
}

enum ChatType {
  LOGIC_REVIEW
}

enum TurnStatus {
  QUEUED
  RUNNING
  WAITING_INPUT
  DONE
  FAILED
}
