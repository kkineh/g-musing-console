# 로컬 SQLite 파일. 실제 데이터가 들어가므로 .env와 *.db는 커밋하지 않는다.
DATABASE_URL="file:./dev.db"

# 엔진 주소. 비워두면 목업으로 동작해서 엔진 없이도 콘솔을 개발할 수 있다.
# ENGINE_URL="http://localhost:4000"

# 개발용 로그인 계정. pnpm db:seed가 이 값으로 계정을 만든다.
# 회원가입이 없고 관리자가 발급하는 구조라, 개발 중에는 시드 계정으로 들어간다.
# 같은 비밀번호로 관리자(hsm)와 일반 사용자(kjm)가 만들어져 역할별 화면을 확인할 수 있다.
DEV_LOGIN_ID="hsm"
DEV_LOGIN_PASSWORD="바꿔서 넣으세요"
