{
  "name": "musing-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "contract": "tsx contract/generate.ts",
    "contract:docs": "pnpm contract && npx -y serve contract -l 4100",
    "contract:mock": "pnpm contract && prism mock contract/openapi.json -p 4000"
  },
  "dependencies": {
    "@orpc/contract": "^1.15.4",
    "@orpc/openapi": "^1.15.4",
    "@orpc/zod": "^1.15.4",
    "@prisma/client": "^6.19.3",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@scalar/cli": "^2.5.2",
    "@stoplight/prism-cli": "^5.16.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0"
}
